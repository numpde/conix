# Closed input set for offline runtime/test packaging. All wheel acquisition
# uses the shared verified wheelhouse and an explicit streamed BuildKit context.
**
!Dockerfile
!pyproject.toml
!requirements/
!requirements/runtime.lock
!requirements/build.lock
!src/
!src/**
!tests/
!tests/**/*.py
!tests/fixtures/catalog.toml
!tools/
!tools/fixtures/
!tools/fixtures/protocol.py
!tools/containers/
!tools/containers/diagnostics.py

!config/
!config/deployments/
!config/deployments/fuji-acceptance/
!config/deployments/fuji-acceptance/abi/
!config/deployments/fuji-acceptance/abi/pay_to_play.json
